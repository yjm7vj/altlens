# AltLens configuration. Every value has a working default, so the demo runs
# with none of this set.

# --- Database (optional) ---
# Only needed for the database-backed path and the seed script. The API serves
# the illustrative demo dataset from memory without it.
# ALTLENS_DATABASE_URL=postgresql://user:password@localhost:5432/altlens

# --- API ---
# Comma-separated origins allowed to call the API.
# ALTLENS_CORS_ORIGINS=http://localhost:5173,https://altlens.vercel.app

# --- Model provider ---
# rule_based (default, no setup), openai, or ollama.
# ALTLENS_MODEL_PROVIDER=rule_based

# OPENAI_API_KEY=sk-...
# ALTLENS_OPENAI_MODEL=gpt-4o-mini

# ALTLENS_OLLAMA_BASE_URL=http://localhost:11434
# ALTLENS_OLLAMA_MODEL=llama3.1

# ALTLENS_REQUEST_TIMEOUT_SECONDS=30
